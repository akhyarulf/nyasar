    <string name="notif_onboarding_skip">Later</string>

    <!-- Location gate (pre-start onboarding) -->
    <string name="location_gate_title">Allow Location?</string>
    <string name="location_gate_body">Recording needs location access (GPS) to:\n• Record the track points you walk\n• Calculate distance, moving time, and elevation\n\nWithout this permission, recording cannot start — no GPS points will be captured.</string>
    <string name="location_gate_allow">Allow Location</string>
    <string name="location_denied_banner">⚠ Location permission not granted — GPS will not be recorded during the session.</string>
    <string name="location_services_off_title">Location Services Off</string>
    <string name="location_services_off_body">Location permission is granted, but your phone\'s location services are currently OFF. Without them, GPS will never get a signal — recording can run while capturing not a single point.\n\nTurn on Location from Quick Settings or the system location page.</string>
    <string name="location_services_off_open">Open Settings</string>
    <string name="location_services_off_banner">⚠ Phone location services are off — GPS will not be recorded even with permission granted.</string>
    <string name="location_denied_grant">Allow</string>
    <string name="location_denied_settings">Open Settings</string>

    <!-- Battery optimization gate (pre-start onboarding) -->
    <string name="battery_gate_title">Allow Unrestricted Battery Use?</string>
    <string name="battery_gate_body">To keep GPS recording accurate while the screen is off or the phone is in your pocket, Nyasar needs an exemption from battery optimization:\n• Some phones (Xiaomi, Samsung, etc.) aggressively kill background GPS\n• Recording still works without this — it\'s just more likely to be interrupted\n\nYou can change this anytime in Settings → GPS.</string>
    <string name="battery_gate_allow">Allow</string>

