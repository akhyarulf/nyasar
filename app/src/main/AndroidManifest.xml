<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Needed only for P1 background navigation; declared now, requested lazily -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Battery-optimization exemption request: lets the user allow Nyasar
         to keep GPS recording alive through vendor battery savers (MIUI,
         Samsung, etc.). The permission only enables the dialog intent —
         the user still decides per system sheet. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Boot auto-resume (2026-11): saat HP selesai reboot, Android
         mengirim BOOT_COMPLETED ke BootCompletedReceiver supaya
         RecordingService bisa berjalan lagi tanpa pengguna membuka app.
         Deklarasi manifest-group saja — tidak butuh grant runtime. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".NyasarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Nyasar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nyasar.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open a .gpx file from a file manager or "Open with" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.gpx" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>

            <!-- Share a .gpx file into Nyasar -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
            </intent-filter>

            <!-- Android App Links (konsep "app bisa dibuka pakai link",
                 2026-09): https://app.nyasarnyaman.my.id/route/{id} dibuka
                 di HP yang punya Nyasar → langsung masuk Route Detail;
                 autoVerify membuat Android mengecek
                 /.well-known/assetlinks.json di domain itu berisi SHA-256
                 dari signing cert kita — jika cocok, link membuka app
                 TANPA dialog "pilih aplikasi". Tanpa app terpasang, link
                 tetap dibuka browser (web landing route di host yang
                 sama). Nav host-nya via navDeepLink di MainActivity
                 (composable "route/{routeId}"). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.nyasarnyaman.my.id" android:pathPrefix="/route" />
            </intent-filter>

            <!-- Auth App Link (auto-login setelah konfirmasi email, 2026-09):
                 tautan konfirmasi sign-up di-redirect Supabase ke
                 https://app.nyasarnyaman.my.id/auth/callback#access_token=…
                 (redirectUrl di AuthRepository.signUpWith). PathPrefix
                 /auth/callback SPESIFIK — sengaja tidak mencakup /auth/reset/
                 agar tautan pemulihan kata sandi tetap terbuka di browser
                 (form resetnya di halaman web). MainActivity meneruskan
                 intent ini ke gotrue-kt via handleDeeplinks → sesi aktif
                 tanpa login manual. Tanpa app, link dibuka browser →
                 halaman fallback web/auth/callback. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.nyasarnyaman.my.id" android:pathPrefix="/auth/callback" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RecordingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Bangunkan kembali rekaman yang terputus oleh reboot: Android
             mengirim BOOT_COMPLETED setelah boot selesai -> receiver
             mengecek DB untuk activity berstatus 'recording'/'paused'
             dan menyalakan RecordingService lagi tanpa pengguna buka app
             (staleness guard 24 jam ada di receiver). exported="false"
             cukup karena BOOT_COMPLETED adalah broadcast SISTEM — menurut
             dok <receiver>, flag exported hanya membatasi pengirim
             NON-sistem; sistem tetap mengirim ke receiver yang tidak
             exported. -->
        <receiver
            android:name=".recording.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Needed to share exported GPX files (route or activity) with
             other apps (WhatsApp, Drive, etc) — spec Export/Share GPX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
