<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen icon (windowSplashScreenAnimatedIcon).

     Layer 1: pale circle filling the whole icon canvas. The splash icon
     is circle-masked on Android 12+ (same geometry as adaptive icons:
     only the inner circle of the canvas is visible), and the compat
     library renders the drawable unmasked on pre-12 — building the pale
     disk INTO the drawable makes both paths look identical.

     Layer 2: splash_logo.png (drawable-nodpi) — a 1152x1152 hi-res
     re-render of the launcher foreground artwork (generated by
     scripts/gen_splash_logo.py), NOT the launcher mipmap itself. The
     launcher foreground PNG only carries ~278x289 px of actual artwork
     (adaptive-icon layout keeps the artwork in the center third), which
     upscaled ~2.5x to a full-screen splash looks soft/blurry. The
     re-render keeps the artwork at the SAME relative position/size
     (full-canvas adaptive geometry), so the splash icon still lands
     exactly where the launcher icon does — just sharp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/splash_icon_backdrop" />
        </shape>
    </item>
    <item android:drawable="@drawable/splash_logo" />
</layer-list>
