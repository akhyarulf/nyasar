    <!-- Notification onboarding (first recording, API 33+) -->
    <string name="notif_onboarding_title">Allow Notifications?</string>
    <string name="notif_onboarding_body">While a GPS recording is running, Nyasar posts a status notification:\n• Recording state (active / paused) and real-time distance\n• A visible sign that recording keeps running when the app goes to the background\n\nWithout this permission, recording still works — only the notification indicator is missing.</string>
